# ========================================
# SkyWeather 天气应用配置（模板文件）
# ========================================
# 将此文件复制为 .env 并填入你的 API Key（仅本地开发用）
#
# 重要：自代理模式上线后，这些 Key 仅由服务端读取使用，
#       前端代码不会以任何形式持有它们。
#       前端通过同源的 /api/* 代理端点访问上游 API。
#
# 部署到 EdgeOne Pages 时：
#   1. 不要把 .env 推送到仓库（已被 .gitignore 忽略）
#   2. 在 EdgeOne Pages 控制台 → 项目设置 → 环境变量 中
#      添加下面的变量，作用域勾选"构建环境"和"运行环境"
#      - 构建环境：build.js 读取后生成只含布尔值的 config.js
#      - 运行环境：edge-functions/api/[[path]].js 读取后用于代理转发
#      - QWEATHER_HOST 只在运行环境使用，作用域勾"运行环境"即可
#   3. 边缘函数通过 context.env.AMAP_KEY 等方式访问，与本地 .env 等价

# 高德地图 Web 服务 Key，用于中国地区天气与地理编码
# 申请地址：https://lbs.amap.com/
AMAP_KEY=你的高德地图Web服务Key

# 和风天气 Web API Key，用于 AQI 空气质量与城市天气
# 申请地址：https://dev.qweather.com/
QWEATHER_KEY=你的和风天气API Key

# 和风天气专属 API Host（强烈建议配置）
# 官方通用域名 geoapi/devapi.qweather.com 已宣布将逐步停用；
# 专属 Host 在控制台「设置」页查看，形如 abcxyz.xy.qweatherapi.com
# 只填域名本身，带不带 https:// 前缀都可以；留空则回退通用域名
QWEATHER_HOST=你的和风专属APIHost

# IPnews API Key，用于 IPv6 网络 IP 定位
# 申请地址：https://ipnews.io/
IPNEWS_KEY=你的IPnews API Key

# 彩云天气 API Token，用于中国区整源天气（实况+逐小时+逐天+国标 AQI 一次返回）
# 申请地址：https://platform.caiyunapp.com/（免费个人 Token，每日有请求数配额）
# Token 只保存在服务端，由代理注入上游 URL 路径，前端不接触
CAIYUN_TOKEN=你的彩云天气Token

# AI 天气生活建议（可选）：按模型链依次尝试，Key 均仅服务端持有；
# 全部未配置时 /api/ai/advice 自动走规则降级（mode:"rule"），前端不受影响
# 首选供应商：Agnes（OpenAI 兼容中转，https://api.agnes-ai.cn/v1），
# 模型 agnes-3.0-flash → agnes-2.5-flash
AGNES_API_KEY=你的AgnesAPIKey

# 次选供应商：智谱开放平台（glm-4.7-flash → glm-4-flash）
# 申请地址：https://open.bigmodel.cn/
ZHIPU_API_KEY=你的智谱APIKey

# 智谱 OpenAI 兼容接口基地址（默认智谱开放平台，一般不用改）
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 智谱模型名覆盖（默认 glm-4.7-flash，备用 glm-4-flash）
# AI_MODEL=glm-4.7-flash
# AI_FALLBACK_MODEL=glm-4-flash

# ========================================
# 服务器配置（可选，仅自建服务器模式即方式 A 使用）
# ========================================
# 代理服务器监听端口，默认 8787
# PORT=8787

# 代理服务器监听地址，默认 0.0.0.0
# HOST=0.0.0.0

# 前端访问代理的基地址（默认空字符串表示与前端同源）
# 仅在"方式 B：前端静态托管 + 独立代理服务"场景下需要设置：
# 把这里设为代理服务器的完整 URL，如 https://api.example.com
# 注意：使用 EdgeOne 边缘函数（方式 D）时不要设置此项，保持空字符串
# API_BASE=https://api.example.com

# 跨域白名单（仅方式 B 需要）：代理默认只接受同源请求，
# 若前端与代理不同域，必须把前端的完整 Origin 填进来，逗号分隔
# ALLOWED_ORIGINS=https://weather.example.com,https://www.example.com
