{
  "appId": "com.skyweather.app",
  "appName": "SkyWeather",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "hostname": "skyweather.local"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0b0f19",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0b0f19",
      "overlaysWebView": true
    },
    "Geolocation": {
      "permissions": ["location"]
    }
  }
}
