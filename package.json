{
    "name": "skyweather",
    "version": "1.0.0",
    "private": true,
    "description": "SkyWeather · 云际天气 - 跨平台天气应用（Web/Android）",
    "scripts": {
        "build": "node build.js",
        "check": "node build.js check",
        "start": "node server.js",
        "dev": "node server.js",
        "postinstall": "node copy-vendor.js",
        "copy-vendor": "node copy-vendor.js",
        "sync:web": "node build.js",
        "prepare:cap": "node prepare-cap.js",
        "cap:sync": "node prepare-cap.js && cap sync",
        "cap:run:android": "node prepare-cap.js && cap sync android && cap run android",
        "cap:open:android": "cap open android",
        "cap:add:android": "cap add android"
    },
    "dependencies": {
        "three": "^0.160.1"
    },
    "devDependencies": {
        "@capacitor/android": "^6.0.0",
        "@capacitor/cli": "^6.0.0",
        "@capacitor/core": "^6.0.0",
        "@capacitor/geolocation": "^6.0.0",
        "@capacitor/splash-screen": "^6.0.0",
        "@capacitor/status-bar": "^6.0.0"
    }
}
